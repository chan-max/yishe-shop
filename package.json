{
  "name": "yishe-shop",
  "version": "0.2.6",
  "description": "Platform for fashion design, POD products, and custom design services",
  "author": "jackie c",
  "private": false,
  "license": "MIT",
  "type": "module",
  "main": "./nuxt.config.ts",
  "repository": {
    "type": "git",
    "url": ""
  },
  "files": [
    "assets",
    "components",
    "composables",
    "layouts",
    "modules",
    "pages",
    "public",
    "stores",
    "app.config.ts",
    "app.vue",
    "nuxt.config.ts",
    "tailwind.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "nuxt build ./apps/shop-main",
    "dev": "nuxt dev ./apps/shop-main --port 15201 --host",
    "dev:main": "nuxt dev ./apps/shop-main --port 15201 --host",
    "dev:card": "nuxt dev ./apps/shop-business-card --port 15202 --host",
    "dev:shop-business-card": "nuxt dev ./apps/shop-business-card --port 15202 --host",
    "dev:couplet": "nuxt dev ./apps/shop-couplets --port 15204 --host",
    "dev:shop-couplet": "nuxt dev ./apps/shop-couplets --port 15204 --host",
    "build:main": "nuxt build ./apps/shop-main",
    "build:card": "nuxt build ./apps/shop-business-card",
    "build:shop-business-card": "nuxt build ./apps/shop-business-card",
    "build:couplet": "nuxt build ./apps/shop-couplets",
    "build:shop-couplet": "nuxt build ./apps/shop-couplets",
    "build:all": "npm run build:main && npm run build:card && npm run build:couplet",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "dev:starter": "nuxt dev ./examples/starter",
    "lint": "eslint --ext \".ts,.js,.vue\" --ignore-path .eslintignore .",
    "lint:fix": "eslint --fix --ext \".ts,.js,.vue\" --ignore-path .eslintignore .",
    "release": "release-it",
    "build:prod": "NODE_ENV=production nuxt build",
    "build:dev": "NODE_ENV=development nuxt generate",
    "build:locales": "node scripts/build-locales.js",
    "build:en": "NUXT_PUBLIC_LOCALE=en nuxt generate",
    "build:zh": "NUXT_PUBLIC_LOCALE=zh nuxt generate"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.2",
    "@nuxt/content": "^3.13.0",
    "@nuxt/devtools": "^4.0.0-alpha.4",
    "@nuxtjs/color-mode": "^4.0.0",
    "@nuxtjs/sitemap": "^8.0.14",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@pinia/nuxt": "^0.11.3",
    "@primeuix/themes": "^1.1.1",
    "@vueuse/core": "^14.2.1",
    "@vueuse/nuxt": "^14.2.1",
    "@yeger/vue-masonry-wall": "^6.1.0",
    "better-sqlite3": "^12.9.0",
    "nuxt-headlessui": "^1.2.2",
    "pinia": "^3.0.4",
    "sass": "^1.69.5",
    "stringify": "^5.2.0",
    "tailwindcss": "^3.3.5",
    "ua-parser-js": "^2.0.3",
    "unplugin-vue-components": "^0.25.2"
  },
  "devDependencies": {
    "@nuxtjs/eslint-config-typescript": "^12.1.0",
    "@nuxtjs/eslint-module": "^4.1.0",
    "@nuxtjs/i18n": "^10.3.0",
    "@nuxtjs/seo": "^5.1.3",
    "consola": "^3.2.3",
    "eslint": "^8.52.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.1",
    "nuxt": "^4.4.2",
    "prettier": "^3.0.3",
    "release-it": "^16.2.1",
    "serve": "^14.2.1",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.2.7"
  },
  "release-it": {
    "github": {
      "release": true,
      "releaseName": "v${version}"
    },
    "git": {
      "commitMessage": "chore(release): release v${version}"
    }
  }
}